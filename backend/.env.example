# =============================================================================
# Vanguard-X backend configuration
# Copy to .env and fill in your key:   cp .env.example .env
# NEVER commit .env — it is gitignored.
# =============================================================================

# --- LLM provider (any OpenAI-compatible endpoint) -------------------------
# OpenRouter. Get a key at https://openrouter.ai/keys
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-replace-me

# OpenRouter model ids are namespaced "vendor/model" — a bare "gpt-4o-mini"
# returns 404 there. Confirm the id is live before relying on it:
#   curl -s https://openrouter.ai/api/v1/models | grep -o '"id":"[^"]*"' | head -40
OPENAI_MODEL=openai/gpt-4o-mini

# Alternatives (comment out OPENAI_BASE_URL for OpenAI direct):
#   OpenAI direct:  OPENAI_API_KEY=sk-...            OPENAI_MODEL=gpt-4o-mini
#   Local Ollama:   OPENAI_BASE_URL=http://localhost:11434/v1
#                   OPENAI_API_KEY=ollama            OPENAI_MODEL=llama3.1:8b
#
# Leaving OPENAI_API_KEY empty is supported: exploration runs without LLM
# analysis instead of failing.

# One LLM call happens per exploration step, so cap the wait. A blocked or
# intercepted endpoint stalls rather than refusing a connection.
OPENAI_TIMEOUT=20
OPENAI_MAX_RETRIES=0

# --- Database --------------------------------------------------------------
DATABASE_URL=sqlite:///./vanguard.db

# --- Browser ---------------------------------------------------------------
# true runs Chromium invisibly; false shows the window (useful for watching it).
HEADLESS=false
